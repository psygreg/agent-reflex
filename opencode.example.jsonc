{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    // Pick ONE entry. "package" is resolved relative to the config file that declares it.
    //
    // Options:
    //   provider       llamacpp | ollama | lmstudio | custom. Sets the default baseURL.
    //   baseURL        OpenAI-compatible base URL. Overrides the provider default.
    //   model          Classifier model ID. Required.
    //   apiKey         Optional Bearer token. Use "{env:NAME}" instead of a literal key.
    //   protocol       "openai" (default, /chat/completions) or "systemone" (/systemone endpoint).
    //   primaryBackend Request format for the main agent model: "anthropic", "llamacpp", "openai" or "zai".
    //                  Sets effort on every primary request. Omit to disable effort control.
    //                  "openai" targets GPT reasoning models: reasoning.effort on Responses API
    //                  (including OpenCode Go GPT endpoints) or reasoning_effort on Chat Completions.
    //                  Use only with GPT models that support reasoning effort.
    //                  "zai" targets GLM models from 5.2 onwards: thinking.type plus
    //                  reasoning_effort on the Z.ai API, reasoning_effort alone on the
    //                  OpenCode Go gateway (detected from the request URL). Non-GLM
    //                  requests stay untouched.
    //   debugLog       Optional file path. Appends each primary request body after rewrites.

    // Classifier on a local llama.cpp server with the System One API (/systemone).
    // Main agent on Anthropic: effort goes to output_config.effort.
    {
      "package": "./plugins/reflex",
      "options": {
        "provider": "llamacpp",
        "baseURL": "http://127.0.0.1:1123/v1",
        "model": "liquid-d1",
        "protocol": "systemone",
        "primaryBackend": "anthropic"
      }
    },

    // Classifier on llama.cpp (OpenAI-compatible chat), main agent also on llama.cpp:
    // effort goes to chat_template_kwargs.enable_thinking (on / off only).
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "llamacpp",
    //     "model": "liquid-d1",
    //     "primaryBackend": "llamacpp"
    //   }
    // },

    // Classifier on llama.cpp (System One API), main agent on a Z.ai GLM model
    // (GLM-5.2 onwards): effort goes to thinking.type + reasoning_effort on the
    // Z.ai API, and to reasoning_effort alone through the OpenCode Go gateway
    // (opencode-go/glm-5.2, glm-5.3, glm-5.3-flash), detected from the request URL.
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "llamacpp",
    //     "model": "liquid-d1",
    //     "protocol": "systemone",
    //     "primaryBackend": "zai"
    //   }
    // },

    // Classifier on llama.cpp (System One API), main agent on an OpenAI GPT reasoning model
    // through either the OpenAI API or OpenCode Go. Effort is written in the endpoint's dialect.
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "llamacpp",
    //     "model": "liquid-d1",
    //     "protocol": "systemone",
    //     "primaryBackend": "openai"
    //   }
    // },

    // Ollama classifier. Effort is not wired for Ollama yet (see README).
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "ollama",
    //     "model": "qwen2.5:3b"
    //   }
    // },

    // LM Studio classifier. Effort is not wired for LM Studio yet (see README).
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "lmstudio",
    //     "model": "qwen2.5-3b-instruct"
    //   }
    // },

    // Remote OpenAI-compatible classifier with an API key from the environment.
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "custom",
    //     "baseURL": "https://YOUR-PROVIDER-HOST/v1",
    //     "model": "YOUR-MODEL-ID",
    //     "apiKey": "{env:SYSTEMONE_API_KEY}"
    //   }
    // }
  ]
}
