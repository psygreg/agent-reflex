{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    // Pick ONE entry. "package" is resolved relative to the config file that declares it.
    //
    // Options:
    //   provider       llamacpp | ollama | lmstudio | typesafe | openrouter | vercel |
    //                  opencode | custom. Sets the default baseURL. The System One
    //                  presets below all serve the classifier at <baseURL>/systemone:
    //                    typesafe   https://api.typesafe.ai/v1 (TypeSafe API, Jev,
    //                               model like "jev-latest")
    //                    openrouter https://openrouter.ai/api/v1 (model like
    //                               "typesafe/jev-1.14" or "~typesafe/jev-latest")
    //                    vercel    https://ai-gateway.vercel.sh/typesafe/v1
    //                               (Vercel AI Gateway, model like "typesafe-ai/jev")
    //                    opencode  https://opencode.ai/zen/v1 (OpenCode Zen, model
    //                               like "jev-1.13" or "jev-1.13-free")
    //   baseURL        Base URL of a System One endpoint. Overrides the provider
    //                  default. The classifier is always asked through the System
    //                  One shape (model, state, questions) at <baseURL>/systemone:
    //                  System One models return typed decisions, never text.
    //   model          Classifier model ID. Required.
    //   fallbackModel  Optional second classifier model on the same endpoint and
    //                  key, retried once when the primary model rejects the
    //                  request — e.g. when a limited-time free model window
    //                  closes ("jev-1.13-free" falling back to "jev-1.13").
    //   apiKey         Optional Bearer token. Use "{env:NAME}" instead of a literal key.
    //   debugLog       Optional file path. Appends each primary request body after rewrites.

    // Classifier on a local llama.cpp server with the System One API (/systemone).
    // Effort control is automatic: every model that supports it gets effort written
    // in its own dialect (see "primaryBackend" note above), so no backend option is
    // needed for any of the examples below.
    {
      "package": "./plugins/reflex",
      "options": {
        "provider": "llamacpp",
        "baseURL": "http://127.0.0.1:1123/v1",
        "model": "liquid-d1"
      }
    },

    // Main agent on llama.cpp: chat_template_kwargs.enable_thinking (on / off only).
    // Main agent on a Z.ai GLM model (GLM-5.2 onwards): thinking.type +
    // reasoning_effort on the Z.ai API, reasoning_effort alone through the
    // OpenCode Go gateway, detected per request.
    // Main agent on an OpenAI GPT reasoning model: reasoning.effort on the
    // Responses API or reasoning_effort on Chat Completions.
    // Multimodel setups work without extra options: each model gets its own
    // fields, so switching models mid-session never sends a foreign field.
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "llamacpp",
    //     "model": "liquid-d1",
    //   }
    // },

    // Classifier on Jev, TypeSafe AI's System One decision model, through the
    // TypeSafe API directly. Model IDs like "jev-latest" or a pinned release.
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "typesafe",
    //     "model": "jev-latest",
    //     "apiKey": "{env:TYPESAFE_API_KEY}"
    //   }
    // },

    // Classifier on Jev through OpenRouter (same OpenRouter API key as the
    // Decisions API). Model IDs like "typesafe/jev-1.14" or "~typesafe/jev-latest".
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "openrouter",
    //     "model": "~typesafe/jev-latest",
    //     "apiKey": "{env:OPENROUTER_API_KEY}"
    //   }
    // },

    // Classifier on Jev through the Vercel AI Gateway (TypeSafe-compatible
    // surface). Model IDs like "typesafe-ai/jev".
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "vercel",
    //     "model": "typesafe-ai/jev",
    //     "apiKey": "{env:AI_GATEWAY_API_KEY}"
    //   }
    // },

    // Classifier on the limited-time free Jev on OpenCode Zen, falling back to
    // the paid twin automatically when the free window closes. Model IDs like
    // "jev-1.13" (paid), "jev-1.13-free" (limited-time free).
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "opencode",
    //     "model": "jev-1.13-free",
    //     "fallbackModel": "jev-1.13",
    //     "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
    //   }
    // },

    // Ollama classifier. The classifier endpoint is not wired for Ollama yet
    // (see README); the effort hooks still work once the endpoint is available.
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "ollama",
    //     "model": "qwen2.5:3b"
    //   }
    // },

    // LM Studio classifier. The classifier endpoint is not wired for LM Studio
    // yet (see README); the effort hooks still work once the endpoint is
    // available.
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "lmstudio",
    //     "model": "qwen2.5-3b-instruct"
    //   }
    // },

    // Custom remote System One endpoint (any server serving the System One shape
    // at <baseURL>/systemone, e.g. a TypeSafe-compatible re-host) with an API
    // key from the environment.
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "custom",
    //     "baseURL": "https://YOUR-PROVIDER-HOST/v1",
    //     "model": "YOUR-MODEL-ID",
    //     "apiKey": "{env:SYSTEMONE_API_KEY}"
    //   }
    // }
  ]
}
