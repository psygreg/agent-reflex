{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    // Pick ONE entry. "package" is resolved relative to the config file that declares it.
    //
    // Options:
    //   provider       llamacpp | ollama | lmstudio | custom. Sets the default baseURL.
    //   baseURL        OpenAI-compatible base URL. Overrides the provider default.
    //   model          Classifier model ID. Required.
    //   apiKey         Optional Bearer token. Use "{env:NAME}" instead of a literal key.
    //   protocol       "openai" (default, /chat/completions) or "systemone" (/systemone endpoint).
    //   primaryBackend DEPRECATED, no effect, accepted for compatibility. Effort
    //                  control is now automatic: the effort dialect is detected
    //                  per request from the model actually being requested, so
    //                  every model gets only the fields its own API accepts —
    //                  including when one gateway (OpenCode Go) proxies many
    //                  models through one server.
    //                  Claude models on /v1/messages endpoints get
    //                  output_config.effort. GPT reasoning models (gpt-5 onwards
    //                  and the o-series) get reasoning.effort on Responses API
    //                  (including OpenCode Go GPT endpoints) or reasoning_effort
    //                  on Chat Completions. GLM models from 5.2 onwards get
    //                  thinking.type plus reasoning_effort on the Z.ai API, and
    //                  reasoning_effort alone on the OpenCode Go gateway (detected
    //                  from the request URL). llama.cpp servers on loopback or
    //                  LAN hosts get chat_template_kwargs.enable_thinking (on/off).
    //                  Requests that speak none of these dialects stay untouched.
    //   debugLog       Optional file path. Appends each primary request body after rewrites.

    // Classifier on a local llama.cpp server with the System One API (/systemone).
    // Effort control is automatic: every model that supports it gets effort written
    // in its own dialect (see "primaryBackend" note above), so no backend option is
    // needed for any of the examples below.
    {
      "package": "./plugins/reflex",
      "options": {
        "provider": "llamacpp",
        "baseURL": "http://127.0.0.1:1123/v1",
        "model": "liquid-d1",
        "protocol": "systemone"
      }
    },

    // Main agent on llama.cpp: chat_template_kwargs.enable_thinking (on / off only).
    // Main agent on a Z.ai GLM model (GLM-5.2 onwards): thinking.type +
    // reasoning_effort on the Z.ai API, reasoning_effort alone through the
    // OpenCode Go gateway, detected per request.
    // Main agent on an OpenAI GPT reasoning model: reasoning.effort on the
    // Responses API or reasoning_effort on Chat Completions.
    // Multimodel setups work without extra options: each model gets its own
    // fields, so switching models mid-session never sends a foreign field.
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "llamacpp",
    //     "model": "liquid-d1",
    //     "protocol": "systemone",
    //     "primaryBackend": "anthropic" // DEPRECATED, no effect: kept only to
    //   }                              // show that old configs still load.
    // },

    // Ollama classifier. Effort is not wired for Ollama yet (see README).
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "ollama",
    //     "model": "qwen2.5:3b"
    //   }
    // },

    // LM Studio classifier. Effort is not wired for LM Studio yet (see README).
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "lmstudio",
    //     "model": "qwen2.5-3b-instruct"
    //   }
    // },

    // Remote OpenAI-compatible classifier with an API key from the environment.
    // {
    //   "package": "./plugins/reflex",
    //   "options": {
    //     "provider": "custom",
    //     "baseURL": "https://YOUR-PROVIDER-HOST/v1",
    //     "model": "YOUR-MODEL-ID",
    //     "apiKey": "{env:SYSTEMONE_API_KEY}"
    //   }
    // }
  ]
}
